{
  "name": "marginalia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun --hot apps/server/src/main.ts",
    "dev:web": "bun --filter @marginalia/web dev",
    "dev": "sh ./scripts/dev.sh",
    "dev:kill": "sh ./scripts/kill-dev.sh",
    "build": "bun --filter @marginalia/web build",
    "start": "bun --bun apps/server/src/main.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:ci": "bun test apps/server/test/server.test.ts apps/server/test/comments.test.ts apps/server/test/mermaid-rust.test.ts apps/server/test/mermaid-prerender.test.ts apps/server/test/mermaid-chromium.test.ts packages/renderer/test packages/cli/test packages/mcp/test apps/web",
    "test:chromium": "MARGINALIA_TEST_PROFILE=chromium bun test apps/server/test/mermaid-chromium.test.ts apps/server/test/export-pdf.test.ts",
    "test:ci:chromium": "MARGINALIA_TEST_PROFILE=chromium bun test apps/server/test/mermaid-chromium.test.ts apps/server/test/export-pdf.test.ts",
    "test:realtime": "bun test apps/server/test/realtime.test.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "latest",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3"
  }
}
